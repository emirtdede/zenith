{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zenith",
  "version": "1.0.0",
  "identifier": "com.vellium.zenith",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zenith",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "theme": null,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Diagnose and repair your Windows PC, safely.",
    "longDescription": "Zenith measures what is actually wrong, explains it plainly, and repairs only what you approve - with a snapshot you can roll back.",
    "copyright": "© 2026 Vellium",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer\\hooks.nsh",
        "languages": ["English", "Turkish"]
      }
    }
  }
}
