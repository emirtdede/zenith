{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zenith",
  "version": "1.0.0",
  "identifier": "com.vellium.zenith",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zenith",
        "create": false,
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "theme": null,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com",
      "capabilities": [
        "default",
        "setup"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Vellium Teknoloji Anonim Sirketi",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Diagnose and repair your Windows PC, safely.",
    "longDescription": "Zenith measures what is actually wrong, explains it plainly, and repairs only what you approve - with a snapshot you can roll back.",
    "copyright": "(c) 2026 Vellium Teknoloji Anonim Sirketi",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer\\hooks.nsh",
        "displayLanguageSelector": true,
        "languages": [
          "Turkish",
          "English",
          "German",
          "French",
          "Spanish",
          "Italian",
          "Portuguese",
          "PortugueseBR",
          "Russian",
          "Japanese",
          "Korean",
          "SimpChinese",
          "TradChinese",
          "Arabic",
          "Hindi",
          "Farsi",
          "Hebrew",
          "Dutch",
          "Polish",
          "Ukrainian",
          "Czech",
          "Slovak",
          "Hungarian",
          "Romanian",
          "Bulgarian",
          "Greek",
          "Swedish",
          "Danish",
          "Norwegian",
          "Finnish",
          "Icelandic",
          "Estonian",
          "Latvian",
          "Lithuanian",
          "Croatian",
          "Serbian",
          "Slovenian",
          "Bosnian",
          "Macedonian",
          "Albanian",
          "Uzbek",
          "Georgian",
          "Armenian",
          "Indonesian",
          "Malay",
          "Vietnamese",
          "Thai",
          "Afrikaans",
          "Catalan",
          "Basque",
          "Galician",
          "Welsh"
        ]
      }
    }
  }
}
