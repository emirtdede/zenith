{
  "name": "zenith",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:simulator": "node scripts/check-simulator.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "check:contract": "node scripts/check-contract.mjs",
    "check:stubs": "cargo run -q -p zenith-core --bin zenith-audit -- --all",
    "check:rust-tests": "cargo test --workspace",
    "verify": "npm run check:locales && npm run check:unused-keys && npm run check:step-keys && npm run check:step-keys-negative && npm run check:contract && npm run check:dashes && npm run check:contrast && npm run check:simulator && npm run check:nonwindows && npm run check:docs && npm run check:fe && npm run check:doc-counts && npm run check:evidence-ledger && npm run check:scorecard && npm run check:ffi && npm run check:licenses && npm run check:deny && npm run check:sbom && npm run check:stubs && npm run check:mutate-restore && npm run check:verify-chain && npm run check:resources && npm run check:workflows && npm run check:rust-tests && npm run build && npm run check:bundle",
    "test": "vitest run",
    "check:fe": "vitest run --reporter=default --reporter=json --outputFile=evidence/vitest-counts.json",
    "check:nonwindows": "node scripts/audit-nonwindows.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:scorecard": "node scripts/check-scorecard.mjs",
    "check:ffi": "node scripts/check-ffi.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:resources": "node scripts/check-resources.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "resources:fetch": "node resources/fetch.mjs",
    "resources:verify": "node resources/fetch.mjs --verify",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:deny": "node scripts/check-deny.mjs",
    "check:sbom": "node scripts/generate-sbom.mjs --check",
    "e2e": "node scripts/e2e-journeys.mjs",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "check:doc-counts": "node scripts/check-doc-counts.mjs",
    "check:doc-counts-mutation": "node scripts/check-doc-counts-mutation.mjs",
    "check:unused-keys": "node scripts/check-unused-keys.mjs",
    "check:step-keys": "node scripts/check-step-keys.mjs",
    "check:build-identity": "node scripts/check-build-identity.mjs",
    "check:build-identity-mutation": "node scripts/check-build-identity-mutation.mjs",
    "check:verify-chain": "node scripts/check-verify-chain.mjs",
    "check:dashes": "node scripts/check-dashes.mjs",
    "check:evidence-ledger": "node scripts/check-evidence-ledger.mjs",
    "check:mutate-restore": "node scripts/check-mutate-restore.mjs",
    "check:step-keys-negative": "node scripts/check-step-keys-negative.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.7"
  }
}
