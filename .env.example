# Release-machine environment: template only.
#
# Copy this file to `.env` on the machine that signs and packages a release,
# fill in values, and never commit it. `.gitignore` ignores `.env` and every
# `.env.*` file except this template, and `gitleaks git` in the release gate
# fails if a real value ever reaches the history.
#
# Nothing in the application reads these. They configure the release scripts
# that run on a build machine, so a normal `npm run verify` needs none of them.

# Password for the EV code-signing certificate when it is supplied as a `.pfx`
# (`scripts/sign-release.ps1 -Pfx <path>`). A certificate held on an HSM or a
# token does not need it: the signer is selected by `-Thumbprint` instead.
ZENITH_PFX_PASSWORD=

# Absolute path to a Chromium-family browser for the screenshot gates
# (`scripts/capture-setup.mjs`, `scripts/sweep-screens.mjs`). Optional: the
# scripts look in the standard Edge and Chrome locations first.
CHROMIUM_PATH=
